{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "selectExample",
			"type": "pickString",
			"description": "Choose which example to run",
			"options": [
				"quickstart",
				"datasetview",
				"error_handling",
				"multiple_datasets",
				"navigation",
				"cleanup",
				"nested_data",
				"compaction",
				"json_roundtrip"
			],
			"default": "quickstart"
		}
	],
	"tasks": [
		{
			"label": "🧹 Clean build",
			"type": "shell",
			"command": "rm",
			"args": [
				"-rf",
				"build"
			],
			"group": "build",
			"problemMatcher": [],
			"detail": "Deletes the entire build directory"
		},
		{
			"label": "⚙️ Configure project (Conan + CMake)",
			"type": "shell",
			"command": "conan install . --output-folder=build --build=missing -s build_type=Release && cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=build/conan_toolchain.cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
			"group": "build",
			"problemMatcher": [],
			"dependsOn": [
				"🧹 Clean build"
			],
			"detail": "Cleans, installs dependencies with Conan, and configures the project with CMake (may take time on first run)"
		},
		{
			"label": "🔨 Compile",
			"type": "shell",
			"command": "cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=build/conan_toolchain.cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLE=OFF -DBUILD_TESTS=OFF > /dev/null 2>&1 && cmake --build build -j",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$gcc",
			"detail": "Compiles the project (library only)"
		},
		{
			"label": "🪛 Recompile",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--clean-first",
				"-j"
			],
			"group": "build",
			"problemMatcher": "$gcc",
			"detail": "Cleans and recompiles the entire project"
		},
		{
			"label": "📦 Compile examples",
			"type": "shell",
			"command": "cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=build/conan_toolchain.cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLE=ON -DBUILD_TESTS=OFF > /dev/null 2>&1 && cmake --build build -j",
			"group": "build",
			"problemMatcher": "$gcc",
			"detail": "Compiles the examples"
		},
		{
			"label": "🚀 Run example",
			"type": "shell",
			"command": "${workspaceFolder}/build/akasha_${input:selectExample}",
			"group": "test",
			"problemMatcher": [],
			"detail": "Select and run one of the examples",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			}
		},
		{
			"label": "🧪 Compile and Run Tests",
			"type": "shell",
			"command": "cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=build/conan_toolchain.cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLE=OFF -DBUILD_TESTS=ON > /dev/null 2>&1 && cmake --build build -j && ./build/akasha_tests",
			"group": "test",
			"problemMatcher": "$gcc",
			"detail": "Compiles tests and runs them only if compilation succeeds"
		},
		{
			"label": "📊 Compile and Run Benchmarks",
			"type": "shell",
			"command": "cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=build/conan_toolchain.cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLE=OFF -DBUILD_TESTS=OFF -DBUILD_BENCHMARKS=ON > /dev/null 2>&1 && cmake --build build -j && ./build/akasha_benchmarks",
			"group": "test"
		}
	]
}